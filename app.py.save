import os
import time
import psutil
from flask import Flask, render_template

# 👇 First, create the Flask app object
app = Flask(__name__)

@app.route("/")
def home():
    return render_template("home.html")

@app.route("/status")
def status():
    cpu = psutil.cpu_percent(interval=1)
    mem = psutil.virtual_memory().percent
    return render_template("status.html", cpu=cpu, mem=mem)

@app.route("/dashboard")
def dashboard():
    # Collect system stats
    cpu = psutil.cpu_percent(interval=1)
    mem = psutil.virtual_memory().percent
    disk = psutil.disk_usage('/').percent

    # Uptime (hours since boot)
    uptime_seconds = time.time() - psutil.boot_time()
    uptime_hours = int(uptime_seconds // 3600)

    # Load averages (1, 5, 15 minutes)
    load1, load5, load15 = os.getloadavg()

    # Network stats (upload/download totals)
    net = psutil.net_io_counters()
    sent_mb = net.bytes_sent / (1024 * 1024)
    recv_mb = net.bytes_recv / (1024 * 1024)

    # Pass everything to the template
    return render_template(
        "dashboard.html",
        cpu=cpu,
        mem=mem,
        disk=disk,
        uptime=uptime_hours,
        load1=load1,
        load5=load5,
        load15=load15,
        sent_mb=sent_mb,
        recv_mb=recv_mb
    )

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)


 
